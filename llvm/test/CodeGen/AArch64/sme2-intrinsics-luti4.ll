; Tests multiple identical luti4 intrinsics with side effects interspersed,
; are not CSD'd.
define void @test_multiple_luti4_zt_i8(ptr %ptrA, ptr %ptrB, ptr %ptrC, ptr %ptrD, <vscale x 16 x i8> %v0, <vscale x 16 x i8> %v1) #0 {
; CHECK-LABEL: test_multiple_luti4_zt_i8:
; CHECK:       // %bb.0:
; CHECK-NEXT:    // kill: def $z1 killed $z1 killed $z0_z1 def $z0_z1
; CHECK-NEXT:    ptrue p0.b
; CHECK-NEXT:    str wzr, [x0]
; CHECK-NEXT:    // kill: def $z0 killed $z0 killed $z0_z1 def $z0_z1
; CHECK-NEXT:    luti4 { z4.b - z7.b }, zt0, { z0, z1 }
; CHECK-NEXT:    str wzr, [x1]
; CHECK-NEXT:    luti4 { z0.b - z3.b }, zt0, { z0, z1 }
; CHECK-NEXT:    st1b { z4.b }, p0, [x2]
; CHECK-NEXT:    st1b { z0.b }, p0, [x3]
; CHECK-NEXT:    ret
  store volatile i32 0, ptr %ptrA
  %res1 = call {<vscale x 16 x i8>, <vscale x 16 x i8>, <vscale x 16 x i8>, <vscale x 16 x i8>} @llvm.aarch64.sme.luti4.zt.x4.nxv16i8(i32 0, <vscale x 16 x i8> %v0, <vscale x 16 x i8> %v1)
  store volatile i32 0, ptr %ptrB
  %res2 = call {<vscale x 16 x i8>, <vscale x 16 x i8>, <vscale x 16 x i8>, <vscale x 16 x i8>} @llvm.aarch64.sme.luti4.zt.x4.nxv16i8(i32 0, <vscale x 16 x i8> %v0, <vscale x 16 x i8> %v1)

  %res1.0 = extractvalue {<vscale x 16 x i8>, <vscale x 16 x i8>, <vscale x 16 x i8>, <vscale x 16 x i8>} %res1, 0
  store <vscale x 16 x i8> %res1.0, ptr %ptrC, align 16
  %res2.0 = extractvalue {<vscale x 16 x i8>, <vscale x 16 x i8>, <vscale x 16 x i8>, <vscale x 16 x i8>} %res2, 0
  store <vscale x 16 x i8> %res2.0, ptr %ptrD, align 16
  ret void
}

