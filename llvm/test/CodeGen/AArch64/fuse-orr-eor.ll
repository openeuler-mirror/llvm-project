; FUSION-NEXT:    orr v0.16b, v1.16b, v0.16b
; FUSION-NEXT:    eor v0.16b, v0.16b, v2.16b
; FUSION-NEXT:    add v1.4s, v4.4s, v3.4s
; FUSION-NEXT:    mul v1.4s, v1.4s, v5.4s
; FUSION-NEXT:    shl v1.4s, v1.4s, #2
; FUSION-NEXT:    and v1.16b, v1.16b, v3.16b
; FUSION-NEXT:    add v0.4s, v1.4s, v0.4s
; FUSION-NEXT:    ret
;
; NOFUSION-LABEL: orr_eor_v16i8:
; NOFUSION:       // %bb.0: // %entry
; NOFUSION-NEXT:    orr v0.16b, v1.16b, v0.16b
; NOFUSION-NEXT:    add v1.4s, v4.4s, v3.4s
; NOFUSION-NEXT:    mul v1.4s, v1.4s, v5.4s
; NOFUSION-NEXT:    shl v1.4s, v1.4s, #2
; NOFUSION-NEXT:    and v1.16b, v1.16b, v3.16b
; NOFUSION-NEXT:    eor v0.16b, v0.16b, v2.16b
; NOFUSION-NEXT:    add v0.4s, v1.4s, v0.4s
; NOFUSION-NEXT:    ret
;
; FUSION-ONLY-LABEL: orr_eor_v16i8:
; FUSION-ONLY:       orr v0.16b, v1.16b, v0.16b
; FUSION-ONLY-NEXT:  eor v0.16b, v0.16b, v2.16b
entry:
  %or.i = or <4 x i32> %b, %a
  %add.i7 = add <4 x i32> %d, %c
  %mul.i = mul <4 x i32> %add.i7, %e
  %vshl_n = shl <4 x i32> %mul.i, splat (i32 2)
  %and.i = and <4 x i32> %vshl_n, %c
  %xor.i = xor <4 x i32> %or.i, %mask
