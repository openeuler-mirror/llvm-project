# NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
# RUN: llc -mtriple=aarch64 -run-pass=aarch64-mi-peephole-opt -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=SHARED
# RUN: llc -mtriple=aarch64 -run-pass=aarch64-mi-peephole-opt -aarch64-base-address-cse=0 -o - %s | FileCheck %s --check-prefix=NOBASECSE
#
# Unit test for the AArch64 base-address CSE peephole (item 10 in
# AArch64MIPeepholeOpt).  Run in isolation via -run-pass, it verifies that
# sibling SUBXri materializations sharing a common source are coalesced into
# one shared base, with the dependent loads rewritten to use it at an adjusted
# immediate offset and the redundant materializations erased.

--- |
  define void @share_sub_i32(ptr %p) {
    %gep0 = getelementptr i32, ptr %p, i64 -100
    %gep1 = getelementptr i32, ptr %p, i64 -99
    %v0 = load i32, ptr %gep0
    %v1 = load i32, ptr %gep1
    store volatile i32 %v0, ptr undef
    store volatile i32 %v1, ptr undef
    ret void
  }

  define void @share_sub_3siblings_i32(ptr %p) {
    %gep0 = getelementptr i32, ptr %p, i64 -100
    %gep1 = getelementptr i32, ptr %p, i64 -99
    %gep2 = getelementptr i32, ptr %p, i64 -98
    %v0 = load i32, ptr %gep0
    %v1 = load i32, ptr %gep1
    %v2 = load i32, ptr %gep2
    store volatile i32 %v0, ptr undef
    store volatile i32 %v1, ptr undef
    store volatile i32 %v2, ptr undef
    ret void
  }

...
---
name: share_sub_i32
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0

    %0:gpr64common = COPY $x0
    %1:gpr64common = SUBXri %0, 400, 0
    %2:gpr64common = SUBXri %0, 396, 0
    %3:gpr32 = LDRWui killed %1, 0 :: (load (s32) from %ir.gep0)
    %4:gpr32 = LDRWui killed %2, 0 :: (load (s32) from %ir.gep1)
    %5:gpr64sp = IMPLICIT_DEF
    STRWui killed %3, %5, 0 :: (volatile store (s32) into `ptr undef`)
    %6:gpr64sp = IMPLICIT_DEF
    STRWui killed %4, %6, 0 :: (volatile store (s32) into `ptr undef`)
    RET_ReallyLR

...
---
name: share_sub_3siblings_i32
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0

    %0:gpr64common = COPY $x0
    %1:gpr64common = SUBXri %0, 400, 0
    %2:gpr64common = SUBXri %0, 396, 0
    %3:gpr64common = SUBXri %0, 392, 0
    %4:gpr32 = LDRWui killed %1, 0 :: (load (s32) from %ir.gep0)
    %5:gpr32 = LDRWui killed %2, 0 :: (load (s32) from %ir.gep1)
    %6:gpr32 = LDRWui killed %3, 0 :: (load (s32) from %ir.gep2)
    %7:gpr64sp = IMPLICIT_DEF
    STRWui killed %4, %7, 0 :: (volatile store (s32) into `ptr undef`)
    %8:gpr64sp = IMPLICIT_DEF
    STRWui killed %5, %8, 0 :: (volatile store (s32) into `ptr undef`)
    %9:gpr64sp = IMPLICIT_DEF
    STRWui killed %6, %9, 0 :: (volatile store (s32) into `ptr undef`)
    RET_ReallyLR

...
# Two siblings: primary %1 (C=400) kept, %2 (C=396) erased, its load uses %1
# with offset 1 ((400-396)/4).
# SHARED-LABEL: name: share_sub_i32
# SHARED:       %1:gpr64common = SUBXri %0, 400, 0
# SHARED-NOT:   SUBXri %0, 396, 0
# SHARED:       %3:gpr32 = LDRWui %1, 0
# SHARED:       %4:gpr32 = LDRWui %1, 1
#
# NOBASECSE-LABEL: name: share_sub_i32
# NOBASECSE:       %1:gpr64common = SUBXri %0, 400, 0
# NOBASECSE:       %2:gpr64common = SUBXri %0, 396, 0
# NOBASECSE:       %3:gpr32 = LDRWui killed %1, 0
# NOBASECSE:       %4:gpr32 = LDRWui killed %2, 0

# Three siblings: primary %1 (C=400) kept, %2 (C=396 -> offset 1) and %3
# (C=392 -> offset 2) erased.
# SHARED-LABEL: name: share_sub_3siblings_i32
# SHARED:       %1:gpr64common = SUBXri %0, 400, 0
# SHARED-NOT:   SUBXri %0, 396, 0
# SHARED-NOT:   SUBXri %0, 392, 0
# SHARED:       %4:gpr32 = LDRWui %1, 0
# SHARED:       %5:gpr32 = LDRWui %1, 1
# SHARED:       %6:gpr32 = LDRWui %1, 2
#
# NOBASECSE-LABEL: name: share_sub_3siblings_i32
# NOBASECSE:       %1:gpr64common = SUBXri %0, 400, 0
# NOBASECSE:       %2:gpr64common = SUBXri %0, 396, 0
# NOBASECSE:       %3:gpr64common = SUBXri %0, 392, 0
